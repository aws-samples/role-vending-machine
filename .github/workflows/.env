# TODO - update Context of the account where the role vending machine should live (eg. IamAdmin account)
TF_VAR_rvm_account_id=111111111111

# Workflow role from the bootstrap script
AWS_WORKFLOW_ROLE=github-workflow-rvm

# Breakglass role from the bootstrap script
# AWS_BREAKGLASS_ROLE=github-breakglass-rvm # uncomment if using breakglass functionality

# breakglass_sender_email=breakglass-emailer@test.lab # REPLACE WITH YOUR BREAKGLASS EMAIL

# TODO - Change if deploying outside of this region
AWS_REGION=us-east-2

TERRAFORM_VERSION=1.9.4

# TODO - update org name in this env file
TF_VAR_default_github_organization_name=<my_github_org> # used for repos that are not on the immutable claim standard (below)
TF_VAR_immutable_github_org_name=<my_github_org@111111111> # required for repos created after 2026-06-15 per https://github.blog/changelog/2026-04-23-immutable-subject-claims-for-github-actions-oidc-tokens/ 

# TODO - comma separated IAM Policy Validator blocking setting (valid values: ERROR,SECURITY_WARNING,WARNING,SUGGESTION,NONE)
IAM_BLOCKER=ERROR
